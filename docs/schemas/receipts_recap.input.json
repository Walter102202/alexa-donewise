{
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "anyOf": [
        {
          "pattern": "^run_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Omit; the server derives the run from the session. Only set when given explicitly.",
      "title": "Run Id"
    }
  },
  "title": "ReceiptsRecapInput",
  "type": "object"
}
