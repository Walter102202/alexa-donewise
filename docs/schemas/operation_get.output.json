{
  "$defs": {
    "Action": {
      "enum": [
        "CALENDAR_CREATE",
        "CALENDAR_RESCHEDULE",
        "PAYMENT_CHARGE"
      ],
      "title": "Action",
      "type": "string"
    },
    "CalendarTarget": {
      "additionalProperties": false,
      "properties": {
        "calendar_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Calendar Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^evt_[A-Za-z0-9_-]+$",
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "calendar_id",
        "event_id",
        "title",
        "start",
        "end",
        "timezone",
        "status"
      ],
      "title": "CalendarTarget",
      "type": "object"
    },
    "Claim": {
      "enum": [
        "EFFECT_VERIFIED",
        "LATEST_READ_MATCHES_TARGET",
        "LATEST_READ_DIFFERS_FROM_TARGET",
        "EFFECT_UNVERIFIED",
        "CHARGED_ONCE",
        "NOTHING_CHARGED",
        "OPERATION_IN_PROGRESS",
        "APPROVAL_REQUIRED"
      ],
      "title": "Claim",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^ev_[A-Za-z0-9_-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "observed_at",
        "version"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "google_calendar",
        "stripe_test",
        "fake_calendar",
        "fake_payments"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "FaultKind": {
      "enum": [
        "drop_response_after_write",
        "ack_without_write",
        "read_unavailable",
        "concurrent_edit",
        "registry_down"
      ],
      "title": "FaultKind",
      "type": "string"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "pattern": "^att_[A-Za-z0-9_-]+$",
          "title": "Attempt Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "write",
            "read",
            "replay",
            "verdict"
          ],
          "title": "Kind",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "kind",
        "at",
        "summary"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "NextAction": {
      "enum": [
        "NONE",
        "CHECK_EXISTING_OPERATION",
        "ASK_USER",
        "GRANT_APPROVAL"
      ],
      "title": "NextAction",
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "VERIFIED",
        "PENDING",
        "NEEDS_APPROVAL",
        "NEEDS_INPUT",
        "NOT_OBSERVED",
        "UNKNOWN",
        "REJECTED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "PaymentTarget": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "exclusiveMinimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "payee": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Payee",
          "type": "string"
        },
        "concept": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Concept",
          "type": "string"
        },
        "status": {
          "enum": [
            "requires_payment_method",
            "requires_confirmation",
            "requires_action",
            "processing",
            "requires_capture",
            "canceled",
            "succeeded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "amount_minor",
        "currency",
        "payee",
        "concept",
        "status"
      ],
      "title": "PaymentTarget",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "POSTCONDITION_MISMATCH",
        "READ_TIMEOUT",
        "WRITE_RESPONSE_LOST_RECOVERED",
        "REPLAY_BUDGET_EXHAUSTED",
        "REPLAY_WINDOW_EXPIRED",
        "RECONCILIATION_EXPIRED",
        "VERSION_CONFLICT",
        "NO_APPROVAL",
        "APPROVAL_MISMATCH",
        "APPROVAL_USED",
        "APPROVAL_EXPIRED",
        "IDEMPOTENCY_PAYLOAD_MISMATCH",
        "AMBIGUOUS_TARGET",
        "UNAUTHORIZED",
        "REGISTRY_UNAVAILABLE"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spoken": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Spoken",
      "type": "string"
    },
    "structured_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Structured Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^op_[A-Za-z0-9_-]+$",
      "title": "Operation Id",
      "type": "string"
    },
    "intent_id": {
      "pattern": "^int_[A-Za-z0-9_-]+$",
      "title": "Intent Id",
      "type": "string"
    },
    "attempt_id": {
      "pattern": "^att_[A-Za-z0-9_-]+$",
      "title": "Attempt Id",
      "type": "string"
    },
    "action": {
      "$ref": "#/$defs/Action"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "expected": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalendarTarget"
        },
        {
          "$ref": "#/$defs/PaymentTarget"
        }
      ],
      "title": "Expected"
    },
    "observed": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalendarTarget"
        },
        {
          "$ref": "#/$defs/PaymentTarget"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Allowed Claims",
      "type": "array"
    },
    "may_claim_success": {
      "title": "May Claim Success",
      "type": "boolean"
    },
    "next_action": {
      "$ref": "#/$defs/NextAction"
    },
    "writes_applied": {
      "minimum": 0,
      "title": "Writes Applied",
      "type": "integer"
    },
    "automatic_retries": {
      "maximum": 1,
      "minimum": 0,
      "title": "Automatic Retries",
      "type": "integer"
    },
    "spoken_subject": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spoken Subject"
    },
    "receipt_id": {
      "anyOf": [
        {
          "pattern": "^rcpt_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Receipt Id"
    },
    "run_id": {
      "pattern": "^run_[A-Za-z0-9_-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "fault_injected": {
      "anyOf": [
        {
          "$ref": "#/$defs/FaultKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryEntry"
      },
      "title": "History",
      "type": "array"
    },
    "payment_intent_id": {
      "anyOf": [
        {
          "pattern": "^pi_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payment Intent Id"
    },
    "charges_applied": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Charges Applied"
    }
  },
  "required": [
    "spoken",
    "operation_id",
    "intent_id",
    "attempt_id",
    "action",
    "outcome",
    "expected",
    "observed",
    "evidence",
    "reason_code",
    "allowed_claims",
    "may_claim_success",
    "next_action",
    "writes_applied",
    "automatic_retries",
    "receipt_id",
    "run_id",
    "fault_injected",
    "observed_at",
    "history"
  ],
  "title": "OperationView",
  "type": "object"
}
