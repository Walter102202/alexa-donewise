GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
STRIPE_SECRET_KEY=
AWS_REGION=
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=
# Public local-demo capability, NOT a production secret. Enables scripted consent/faults.
DEMO_ADMIN_TOKEN=local-sandbox-demo-only
MCP_BEARER_TOKEN=
DONEWISE_MODE=sandbox
DONEWISE_PENDING_AFTER=0.45
# Default: data/<mode> (data/sandbox or data/connected) so the two registries never mix.
# DONEWISE_DATA_DIR=./data/connected
ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
HOST=127.0.0.1
PORT=8765
FAKE_PAYMENT_DELAY_SECONDS=0.65
MCP_URL=http://127.0.0.1:8765/mcp
LLM_PROVIDER=none
# Timezone the demo user schedules in: America/Los_Angeles (PRD story) or America/Santiago.
USER_TIMEZONE=America/Los_Angeles
ANTHROPIC_MODEL=claude-sonnet-5
SIM_PORT=8080
